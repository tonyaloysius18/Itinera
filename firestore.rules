rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Profiles ──
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Invites ──
    match /invites/{inviteId} {
      // Anyone signed in can read an invite (needed to look up by code before joining)
      allow read: if request.auth != null;
      // Only the trip owner creates invites; createdBy must be them
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      // Creator can revoke/update their own invite
      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── Shared itineraries (share by link) — a sanitized copy of a trip: places and common factors only.
    // Readable by anyone who has the unguessable id (the hosted preview page and the app both fetch by id), but the
    // collection can never be listed. Whoever creates one must first have written their private record
    // users/{uid}/sharedLinks/{id}; that record is also what authorizes deleting it, so no owner id is stored here.
    match /sharedItineraries/{shareId} {
      allow get: if true;
      // The Community feed: only moderator-approved items (feed == true), signed-in users, and always with a page limit.
      allow list: if request.auth != null && resource.data.feed == true && request.query.limit <= 50;
      // Clients may only create an unreviewed, uncounted copy: status/feed/approvedAt/copyCount are moderator-controlled,
      // and an author id is only accepted (and only equal to the caller) when the owner asked to be listed.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/sharedLinks/$(shareId))
        && request.resource.data.id == shareId
        && request.resource.data.keys().hasOnly(['id', 'title', 'description', 'countries', 'budgetTier', 'paceTag', 'coverImageUrl', 'days', 'legs', 'sharedAt', 'listRequested', 'authorUid', 'status', 'feed', 'approvedAt', 'copyCount'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.days is list && request.resource.data.days.size() <= 60
        && request.resource.data.get('status', '') == ''
        && request.resource.data.get('feed', false) == false
        && request.resource.data.get('approvedAt', 0) == 0
        && request.resource.data.get('copyCount', 0) == 0
        && (request.resource.data.get('authorUid', '') == ''
            || (request.resource.data.get('listRequested', false) == true && request.resource.data.authorUid == request.auth.uid));
      // The only client update: +1 to copyCount, once per person. The per-person marker (copies/{uid}) must be created in
      // the same batch and must not already exist.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['copyCount'])
        && request.resource.data.copyCount == resource.data.copyCount + 1
        && !exists(/databases/$(database)/documents/sharedItineraries/$(shareId)/copies/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/sharedItineraries/$(shareId)/copies/$(request.auth.uid));
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/sharedLinks/$(shareId));

      match /copies/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list, update, delete: if false;
      }
    }

    // ── Trip templates (Discover) — curated, read-only content; authored out of
    // band (see tools/seed/), never written from the app.
    match /tripTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Trips ──
    match /trips/{tripId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner';

      // Update allowed if:
      //  (A) editor/owner editing content (members & memberIds unchanged), or
      //  (B) owner changing anything (incl. members), or
      //  (C) a NEW user joining themselves as viewer via a valid invite (self-join)
      allow update: if request.auth != null && (
        // (A) editor/owner, membership unchanged
        (
          (resource.data.members[request.auth.uid] == 'owner'
           || resource.data.members[request.auth.uid] == 'editor')
          && request.resource.data.members == resource.data.members
          && request.resource.data.memberIds == resource.data.memberIds
        )
        // (B) owner can change anything
        || resource.data.members[request.auth.uid] == 'owner'
        // (C) self-join: caller was NOT a member, is adding ONLY themselves as viewer
        || (
          !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == 'viewer'
          // everything else about the trip stays the same:
         && request.resource.data.diff(resource.data).affectedKeys()
     			.hasOnly(['members', 'memberIds', 'memberInfo'])
        )
        // (D) self-leave: a non-owner removes ONLY themselves
        || (
          request.auth.uid in resource.data.memberIds
          && resource.data.memberIds.removeAll(request.resource.data.memberIds).hasOnly([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'memberInfo'])
          && resource.data.members[request.auth.uid] != 'owner'
        )
      );

      allow delete: if request.auth != null
        && resource.data.members[request.auth.uid] == 'owner';

      match /documents/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
      match /expenses/{expId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
       match /payments/{payId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
      match /activities/{actId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
      match /neraMessages/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
    }

    // ── Collection-group reads ──
    match /{path=**}/documents/{docId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
    }
    match /{path=**}/expenses/{expId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
    }
     match /{path=**}/payments/{payId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
    }
    match /{path=**}/activities/{actId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
    }
  }
}
